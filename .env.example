# 当前本地开发数据库：现有 PostgreSQL ai（保留其中的全部业务数据）
# 请替换 LOCAL_PASSWORD；密码含特殊字符时需做 URL 编码。
LOCAL_SOURCE_DATABASE_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:5432/ai
DATABASE_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:5432/ai
DIRECT_URL=postgresql://postgres:LOCAL_PASSWORD@127.0.0.1:5432/ai

# 当前不使用 ai_migration_test。数据库已有表时，不要对本地 ai 盲目运行 prisma db push。
# 缺少 Prisma 枚举类型时，先备份数据库，再按部署手册执行 db:repair:postgres-enums。

# 将数据迁往 Supabase 时：保持 LOCAL_SOURCE_DATABASE_URL 指向本地 ai（只读源），
# 仅把 DATABASE_URL 改成 Supabase Transaction Pooler，DIRECT_URL 改成 Supabase Session Pooler / direct URL。
# 常见端口分别为 6543 与 5432；必须从 Supabase Dashboard > Connect 复制真实连接串，不能猜主机名。

# Supabase project/storage
SUPABASE_URL=https://jspkpnnlvgbifujzimpq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=site-assets
SUPABASE_STORAGE_MAX_FILE_SIZE_MB=50
SUPABASE_STORAGE_MAKE_PUBLIC=false

# Public canonical URL for SEO/sitemap; change to the real Vercel domain after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Security: use different strong random values; do not commit real secrets.
ADMIN_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
STORAGE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Existing local uploads folder. Set to the absolute path if assets are in another project folder.
LOCAL_UPLOAD_ROOT=public/uploads
# Historical/non-business source tables explicitly skipped by one-time PostgreSQL copy.
MIGRATION_IGNORED_SOURCE_TABLES=mysql_prisma_migrations_archive

DATABASE_CONNECTION_LIMIT=3
